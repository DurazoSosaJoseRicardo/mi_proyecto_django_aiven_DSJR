# Mismas claves que .env, con valores de ejemplo en vez de los reales
DB_NAME=defaultdb
DB_USER=tu-usuario
DB_PASSWORD=tu-password
DB_HOST=tu-host.aivencloud.com
DB_PORT=12345
# genera la tuya con: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=cambia-esto
# True en local, False en Render
DEBUG=True
# en Render: tu-proyecto.onrender.com
ALLOWED_HOSTS=127.0.0.1,localhost
# en Render: https://tu-proyecto.onrender.com
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
